{
  "name": "tax-break",
  "version": "1.0.0",
  "private": true,
  "description": "Online Indian Annual Income Tax Calculation Portal",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm run test --workspace=packages/tax-engine",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "build": "npm run build --workspace=packages/tax-engine && npm run build --workspace=server && npm run build --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "license": "MIT"
}
