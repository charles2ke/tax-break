# Copy this file to .env (or set these as real environment variables) and fill in the values.

# Port the Express server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Path to the SQLite database file used for accounts, saved returns, and admin config overrides.
# Defaults to server/data/tax-break.sqlite3 if not set.
DB_PATH=./data/tax-break.sqlite3

# Secret used to sign authentication JWTs. Required in production (min 16 characters); in
# development a random secret is generated per process restart if left unset, which invalidates
# existing sessions on every restart.
JWT_SECRET=

# Secret used by express-session to sign the session cookie that stores the CSRF token secret
# (session-based CSRF protection via `lusca`; the session itself is not used for authentication).
# Required in production; in development a random secret is generated per process restart if left
# unset, which invalidates outstanding CSRF tokens on every restart.
SESSION_SECRET=

# Set to "production" to enable stricter cookie settings (Secure flag) and require JWT_SECRET and
# SESSION_SECRET.
NODE_ENV=development

# --- E-filing provider -------------------------------------------------------
# "mock" (default) simulates a submission and clearly labels the acknowledgement as simulated.
# "eri" talks to a licensed ERI/GSP partner's REST API and requires the credentials below.
EFILING_PROVIDER=mock
ERI_API_BASE_URL=
ERI_CLIENT_ID=
ERI_CLIENT_SECRET=
# Optional ERI registration number sent with each submission.
ERI_ID=
# Optional endpoint path overrides if your partner's API differs from the defaults.
ERI_TOKEN_PATH=/auth/token
ERI_SUBMIT_PATH=/itr/submit
ERI_STATUS_PATH=/itr/status
ERI_FORM26AS_PATH=/ais/form26as

# --- Foreign exchange rates --------------------------------------------------
# "static" (default) uses a built-in fallback table; "ecb" fetches the European Central Bank daily
# reference rates and caches the snapshot in SQLite for the rest of the day.
FX_RATES_PROVIDER=static
FX_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# --- Outbound email ----------------------------------------------------------
# "console" (default) logs the message instead of sending it; "http" posts to a transactional email
# provider's REST API.
MAIL_PROVIDER=console
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=no-reply@example.com

# --- OAuth sign-in -----------------------------------------------------------
# Leave blank to keep email/password as the only sign-in method. The redirect URI registered with
# each provider must be <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:4000
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173

# --- Outbound HTTP -----------------------------------------------------------
# Timeout in milliseconds applied to every outbound integration request.
HTTP_TIMEOUT_MS=10000
