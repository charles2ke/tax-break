# Copy this file to .env (or set these as real environment variables) and fill in the values.

# Port the Express server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Path to the SQLite database file used for accounts, saved returns, and admin config overrides.
# Defaults to server/data/tax-break.sqlite3 if not set.
DB_PATH=./data/tax-break.sqlite3

# Secret used to sign authentication JWTs. Required in production (min 16 characters); in
# development a random secret is generated per process restart if left unset, which invalidates
# existing sessions on every restart.
JWT_SECRET=

# Secret used by express-session to sign the session cookie that stores the CSRF token secret
# (session-based CSRF protection via `lusca`; the session itself is not used for authentication).
# Required in production; in development a random secret is generated per process restart if left
# unset, which invalidates outstanding CSRF tokens on every restart.
SESSION_SECRET=

# Set to "production" to enable stricter cookie settings (Secure flag) and require JWT_SECRET and
# SESSION_SECRET.
NODE_ENV=development
